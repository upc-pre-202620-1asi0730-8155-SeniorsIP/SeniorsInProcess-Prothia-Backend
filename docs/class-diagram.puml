package "IAM Bounded Context" as IamContext {
    class User <<AggregateRoot>> extends Shared.AggregateRoot {
        +Id: int
        +Username: string
        +PasswordHash: string
        +ValidatePassword(password, hashingService): bool
    }

    interface IUserRepository extends Shared.IBaseRepository {
        +FindByUsernameAsync(username): Task<User?>
        +ExistsByUsernameAsync(username): Task<bool>
    }

    interface ITokenService {
        +GenerateToken(user): string
    }

    interface IHashingService {
        +HashPassword(password): string
        +VerifyPassword(password, hash): bool
    }

    class AuthenticationController
    class UsersController
}

@enduml
