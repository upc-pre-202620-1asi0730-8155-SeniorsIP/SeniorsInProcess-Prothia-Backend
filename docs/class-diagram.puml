@startuml Prothia.API Class Diagram - Tactical Domain-Driven Design Model

title 
    Prothia Platform API
    Domain-Driven Design Tactical Class Diagram
    Bounded Contexts: Shared, Patients, Prescriptions, Monitoring, Workshop, Communication, Analytics, Billing, IAM
end title

skinparam classAttributeIconSize 0
skinparam monochrome false
skinparam packageStyle rectangle

package "Shared Bounded Context" as Shared {
    interface IAggregateRoot {
        +DomainEvents: IReadOnlyCollection<IEvent>
        +ClearDomainEvents(): void
    }

    abstract class AggregateRoot implements IAggregateRoot {
        -domainEvents: List<IEvent>
        +DomainEvents: IReadOnlyCollection<IEvent>
        #AddDomainEvent(IEvent domainEvent): void
        +ClearDomainEvents(): void
    }

    class Error <<record>> {
        +Code: string
        +Description: string
        +Type: ErrorType
        +{static} None: Error
        +{static} NotFound(code, description): Error
        +{static} Conflict(code, description): Error
        +{static} Validation(code, description): Error
    }

    enum ErrorType {
        Failure
        Validation
        NotFound
        Conflict
        Unauthorized
        Forbidden
    }

    class "Result<T>" as Result {
        +IsSuccess: bool
        +IsFailure: bool
        +Value: T
        +Error: Error
        +{static} Success(T value): Result<T>
        +{static} Failure(Error error): Result<T>
        +Match<TResult>(onSuccess, onFailure): TResult
    }

    interface "IBaseRepository<TEntity>" as IBaseRepository {
        +AddAsync(entity): Task
        +FindByIdAsync(id): Task<TEntity?>
        +FindByIdAsNoTrackingAsync(id): Task<TEntity?>
        +Update(entity): void
        +Remove(entity): void
        +ListAsync(): Task<IEnumerable<TEntity>>
        +ListAsNoTrackingAsync(): Task<IEnumerable<TEntity>>
    }

    interface IUnitOfWork {
        +CompleteAsync(): Task
    }
}

package "Patients Bounded Context" as PatientsContext {
    class Patient <<AggregateRoot>> extends Shared.AggregateRoot {
        +Id: int
        +FullName: string
        +Dni: Dni
        +Age: int
        +Amputation: EAmputation
        +KLevel: EKLevel
        +ProsthesisCode: string
        +Adherence: int
        +Symmetry: int
        +Status: EStatus
        +Update(fullName, dni, age, amputation, kLevel, prosthesisCode): void
    }

    class Dni <<ValueObject>> {
        +Value: string
    }

    enum EAmputation {
        TranstibialRight
        TranstibialLeft
        TranstibialBilateral
        TransfemoralRight
        TransfemoralLeft
        TransfemoralBilateral
    }

    enum EKLevel {
        K1
        K2
        K3
        K4
    }

    enum EStatus {
        Stable
        Alert
        Critical
    }

    interface IPatientRepository extends Shared.IBaseRepository {
        +FindByDniAsync(dni): Task<Patient?>
        +ExistsByDniAsync(dni): Task<bool>
    }

    interface IPatientCommandService {
        +Handle(CreatePatientCommand): Task<Result<Patient>>
        +Handle(UpdatePatientCommand): Task<Result<Patient>>
        +Handle(DeletePatientCommand): Task<Result<bool>>
    }

    interface IPatientQueryService {
        +Handle(GetAllPatientsQuery): Task<IEnumerable<Patient>>
        +Handle(GetPatientByIdQuery): Task<Patient?>
        +Handle(GetPatientByDniQuery): Task<Patient?>
    }

    class PatientsController {
        +CreatePatient(CreatePatientResource): Task<IActionResult>
        +GetAllPatients(): Task<IActionResult>
        +GetPatientById(id): Task<IActionResult>
        +UpdatePatient(id, UpdatePatientResource): Task<IActionResult>
        +DeletePatient(id): Task<IActionResult>
    }

    Patient *-- Dni
    Patient *-- EAmputation
    Patient *-- EKLevel
    Patient *-- EStatus
    PatientsController ..> IPatientCommandService
    PatientsController ..> IPatientQueryService
}

package "Prescriptions Bounded Context" as PrescriptionsContext {
    class Prescription <<AggregateRoot>> extends Shared.AggregateRoot {
        +Id: int
        +PatientId: int
        +PhaseNumber: int
        +PhaseName: string
        +DurationWeeks: int
        +FrequencyPerWeek: int
        +Exercises: List<PrescribedExercise>
        +AddExercise(exerciseId, name, sets, reps, restSeconds): void
    }

    class PrescribedExercise <<Entity>> {
        +Id: int
        +PrescriptionId: int
        +ExerciseId: int
        +Name: string
        +Sets: int
        +Reps: int
        +RestSeconds: int
    }

    class Exercise <<AggregateRoot>> extends Shared.AggregateRoot {
        +Id: int
        +Name: string
        +Focus: string
    }

    interface IPrescriptionRepository extends Shared.IBaseRepository {
        +FindByPatientIdAsync(patientId): Task<Prescription?>
    }

    interface IExerciseRepository extends Shared.IBaseRepository

    interface IPrescriptionCommandService {
        +Handle(CreatePrescriptionCommand): Task<Result<Prescription>>
    }

    interface IPrescriptionQueryService {
        +Handle(GetAllPrescriptionsQuery): Task<IEnumerable<Prescription>>
        +Handle(GetPrescriptionByIdQuery): Task<Prescription?>
        +Handle(GetPrescriptionByPatientIdQuery): Task<Prescription?>
        +Handle(GetAllExercisesQuery): Task<IEnumerable<Exercise>>
    }

    class PrescriptionsController
    class ExercisesController

    Prescription *-- PrescribedExercise
    PrescriptionsController ..> IPrescriptionCommandService
    PrescriptionsController ..> IPrescriptionQueryService
    ExercisesController ..> IPrescriptionQueryService
}

package "Monitoring Bounded Context" as MonitoringContext {
    class Alert <<AggregateRoot>> extends Shared.AggregateRoot {
        +Id: int
        +PatientId: int
        +PatientName: string
        +DeviationType: string
        +RecordedValue: string
        +Threshold: string
        +Severity: AlertSeverity
        +Status: AlertStatus
        +OccurredAt: DateTime
        +ResolvedAt: DateTime?
        +Resolve(): void
    }

    enum AlertSeverity {
        Warning
        Critical
    }

    enum AlertStatus {
        Pending
        Resolved
    }

    class ThresholdProfile <<AggregateRoot>> extends Shared.AggregateRoot {
        +Id: int
        +PatientId: int
        +PelvicTilt: double
        +Asymmetry: double
        +Cadence: double
        +ImpactPeak: double
        +Update(pelvicTilt, asymmetry, cadence, impactPeak): void
    }

    class GaitSession <<AggregateRoot>> extends Shared.AggregateRoot {
        +Id: int
        +PatientId: int
        +RecordedAt: DateTime
        +DurationMinutes: int
        +Steps: int
        +Cadence: int
        +SymmetryPercent: double
        +AlertsCount: int
        +ImpactPeakNewtons: int
    }

    interface IAlertRepository extends Shared.IBaseRepository
    interface IThresholdProfileRepository extends Shared.IBaseRepository {
        +FindByPatientIdAsync(patientId): Task<ThresholdProfile?>
    }
    interface IGaitSessionRepository extends Shared.IBaseRepository {
        +ListByPatientIdAsync(patientId): Task<IEnumerable<GaitSession>>
    }

    class AlertsController
    class ThresholdProfilesController
    class GaitSessionsController
}

